#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -f "$root/upstream/docker-compose.yml" ]; then
  echo "Missing upstream submodule. Run: git submodule update --init --recursive" >&2
  exit 1
fi
exec docker compose --project-directory "$root" \
  -f "$root/upstream/docker-compose.yml" -f "$root/compose.dind.yml" "$@"
